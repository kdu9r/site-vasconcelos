# Vasconcelos Corretor — Apache (HostGator)

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # vasconceloscorretor.com → www.vasconceloscorretor.com (subdomínios de teste não são afetados)
  RewriteCond %{HTTP_HOST} ^vasconceloscorretor\.com$ [NC]
  RewriteRule ^ https://www.vasconceloscorretor.com%{REQUEST_URI} [L,R=301]

  # Bloqueia arquivos ocultos e de sistema (.git, .env, etc.)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(sql|log|ini|bak|sh|md|json|lock|dist)$ - [F,L,NC]

  # Arquivos reais (fotos, css, js) são servidos direto; o resto vai para o index.php
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Nenhum outro .php além do index.php pode ser executado
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  <FilesMatch "\.(css|js|svg|woff2|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml text/plain
</IfModule>
